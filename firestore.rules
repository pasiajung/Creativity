rules_version = '2';

// ─────────────────────────────────────────────────────────────
// Firestore 보안 규칙
// 사용 방법: 이 파일 내용을 통째로 복사해 Firebase 콘솔 > Firestore Database > 규칙 탭에 붙여 넣고 "게시"를 누릅니다.
//
// ✏️ 고칠 수 있는 곳은 두 군데입니다. (src/config.ts 의 같은 설정과 항상 맞춰 주세요)
//   1) isAdmin()        : 관리자 이메일 목록 (config.ts 의 ADMIN_EMAILS)
//   2) canParticipate() : 참여 허용 도메인 (config.ts 의 ALLOWED_EMAIL_DOMAIN)
// ─────────────────────────────────────────────────────────────

service cloud.firestore {
  match /databases/{database}/documents {

    // ── 공통 함수 ─────────────────────────────────────────

    function signedIn() {
      return request.auth != null;
    }

    // ✏️ 1) 관리자 이메일 목록. 여러 명이면 ['a@gmail.com', 'b@kmu.ac.kr'] 처럼 추가합니다.
    function isAdmin() {
      return signedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['pasiajung@gmail.com'];
    }

    // ✏️ 2) 글·댓글을 쓸 수 있는 사람. 지금은 Google 로그인한 누구나 참여할 수 있습니다.
    //    학교 계정(@kmu.ac.kr)만 허용하려면 아래 "// &&" 로 시작하는 줄 맨 앞의 // 를 지우세요.
    //    (config.ts 의 ALLOWED_EMAIL_DOMAIN = 'kmu.ac.kr' 도 함께 바꿉니다)
    function canParticipate() {
      return signedIn()
        // && request.auth.token.email_verified == true && request.auth.token.email.matches('.*@kmu[.]ac[.]kr$')
        ;
    }

    function isOwner(data) {
      return signedIn() && data.authorId == request.auth.uid;
    }

    // 정해진 필드만 정확히 있는지 (허용 필드 외 추가 금지)
    function hasExactly(data, fields) {
      return data.keys().hasAll(fields) && data.keys().hasOnly(fields);
    }

    // 이번 수정에서 바뀐 필드가 허용 목록 안에만 있는지
    function changesOnly(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    // 빈칸이 아닌 문자열이고 최대 길이 이하인지
    function validText(value, maxLength) {
      return value is string && value.size() <= maxLength && value.trim().size() > 0;
    }

    function validAuthor(data) {
      return data.authorId == request.auth.uid
        && data.authorName is string && data.authorName.size() > 0 && data.authorName.size() <= 100
        && (data.authorPhoto == null || (data.authorPhoto is string && data.authorPhoto.size() <= 2048));
    }

    // ── 댓글·답글 공통 규칙 ───────────────────────────────
    // 필드: authorId, authorName, authorPhoto, text(최대 2000자), createdAt, updatedAt

    function commentFields() {
      return ['authorId', 'authorName', 'authorPhoto', 'text', 'createdAt', 'updatedAt'];
    }

    function validNewComment() {
      let d = request.resource.data;
      return canParticipate()
        && hasExactly(d, commentFields())
        && validAuthor(d)
        && validText(d.text, 2000)
        && d.createdAt == request.time
        && d.updatedAt == null;
    }

    // 수정: 본인 또는 관리자, text·updatedAt 만 변경 (authorId·createdAt 변경 금지)
    function validCommentEdit() {
      return (isOwner(resource.data) || isAdmin())
        && changesOnly(['text', 'updatedAt'])
        && validText(request.resource.data.text, 2000)
        && request.resource.data.updatedAt == request.time;
    }

    // ── 사용자 프로필: users/{uid} ────────────────────────

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());

      allow create: if signedIn() && request.auth.uid == uid
        && hasExactly(request.resource.data, ['displayName', 'photoURL', 'affiliation', 'createdAt'])
        && request.resource.data.displayName is string && request.resource.data.displayName.size() <= 100
        && (request.resource.data.photoURL == null
            || (request.resource.data.photoURL is string && request.resource.data.photoURL.size() <= 2048))
        && request.resource.data.affiliation is string && request.resource.data.affiliation.size() <= 100
        && request.resource.data.createdAt == request.time;

      allow update: if signedIn() && request.auth.uid == uid
        && changesOnly(['displayName', 'photoURL', 'affiliation'])
        && request.resource.data.displayName is string && request.resource.data.displayName.size() <= 100
        && (request.resource.data.photoURL == null
            || (request.resource.data.photoURL is string && request.resource.data.photoURL.size() <= 2048))
        && request.resource.data.affiliation is string && request.resource.data.affiliation.size() <= 100;

      allow delete: if false;
    }

    // ── 연구·수업 상세 댓글: posts/{targetId}/comments/{commentId} ──

    match /posts/{targetId}/comments/{commentId} {
      allow read: if true;
      allow create: if targetId.matches('^(research|teaching)-[a-z0-9-]{1,100}$') && validNewComment();
      allow update: if validCommentEdit();
      allow delete: if isOwner(resource.data) || isAdmin();
    }

    // ── 토론 게시판: threads/{threadId} ───────────────────
    // 글 ID 는 "앞 13자리 = 10000000000000 - 작성 시각(밀리초)" 형식이라 ID 순서가 곧 최신순입니다.

    function threadFields() {
      return ['title', 'body', 'category', 'relatedTargetId',
              'authorId', 'authorName', 'authorPhoto', 'replyCount', 'createdAt', 'updatedAt'];
    }

    function validThreadContent(d) {
      return validText(d.title, 100)
        && validText(d.body, 5000)
        && d.category in ['연구', '수업방식', '자료공유', '자유']
        && (d.relatedTargetId == null
            || (d.relatedTargetId is string && d.relatedTargetId.matches('^(research|teaching)-[a-z0-9-]{1,100}$')));
    }

    // 글 ID 가 작성 시각과 맞는지 (순서 조작 방지, 시계 오차 1시간 허용)
    function validThreadId(threadId) {
      return threadId.matches('^[0-9]{13}-[A-Za-z0-9]{8}$')
        && math.abs(int(threadId.split('-')[0]) + request.time.toMillis() - 10000000000000) <= 3600000;
    }

    match /threads/{threadId} {
      allow read: if true;

      allow create: if canParticipate()
        && validThreadId(threadId)
        && hasExactly(request.resource.data, threadFields())
        && validAuthor(request.resource.data)
        && validThreadContent(request.resource.data)
        && request.resource.data.replyCount == 0
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == null;

      // (1) 작성자·관리자의 내용 수정: authorId·createdAt·replyCount 변경 금지
      // (2) 답글 등록·삭제 시 로그인 사용자의 replyCount ±1 변경 (writeBatch 로 답글과 함께 처리)
      allow update: if (
          (isOwner(resource.data) || isAdmin())
          && changesOnly(['title', 'body', 'category', 'relatedTargetId', 'updatedAt'])
          && validThreadContent(request.resource.data)
          && request.resource.data.updatedAt == request.time
        ) || (
          canParticipate()
          && changesOnly(['replyCount'])
          && request.resource.data.replyCount is int
          && request.resource.data.replyCount >= 0
          && (request.resource.data.replyCount == resource.data.replyCount + 1
              || request.resource.data.replyCount == resource.data.replyCount - 1)
        );

      allow delete: if isOwner(resource.data) || isAdmin();

      // ── 토론 답글: threads/{threadId}/replies/{replyId} ──
      match /replies/{replyId} {
        allow read: if true;

        // 답글 등록과 replyCount +1 이 반드시 한 묶음(writeBatch)으로 처리되어야 합니다.
        allow create: if validNewComment()
          && exists(/databases/$(database)/documents/threads/$(threadId))
          && getAfter(/databases/$(database)/documents/threads/$(threadId)).data.replyCount
             == get(/databases/$(database)/documents/threads/$(threadId)).data.replyCount + 1;

        allow update: if validCommentEdit();

        // 삭제 시 replyCount -1 도 한 묶음으로 처리 (글이 이미 삭제된 경우는 예외)
        allow delete: if (isOwner(resource.data) || isAdmin())
          && (!exists(/databases/$(database)/documents/threads/$(threadId))
              || getAfter(/databases/$(database)/documents/threads/$(threadId)).data.replyCount
                 == get(/databases/$(database)/documents/threads/$(threadId)).data.replyCount - 1);
      }
    }

    // ── 위에 적지 않은 모든 경로는 읽기·쓰기 모두 거부 ─────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
