# Firebase 설정값 (Phase 2에서 사용합니다)
# 1) 이 파일을 복사해 같은 폴더에 ".env" 라는 이름으로 저장합니다.
# 2) Firebase 콘솔 > 프로젝트 설정 > 내 앱 > SDK 설정 및 구성에서 값을 복사해 붙여 넣습니다.
# 3) .env 파일은 GitHub에 올라가지 않습니다(.gitignore에 등록됨).
# 배포 사이트에서는 같은 이름·값을 Netlify 환경 변수에 입력합니다.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
